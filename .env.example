# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.  NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Layer 2: Anthropic (Claude) API ---------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Analyst model. Defaults to the current Sonnet tier (claude-sonnet-5).
# The original spec asked for "Claude 3.5 Sonnet", which is deprecated;
# claude-sonnet-5 is its current, cheaper, more capable successor.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Layer 4: Alpaca broker (PAPER TRADING ONLY) ---------------------------
# Create PAPER keys at https://app.alpaca.markets/paper/dashboard/overview
# Leave blank to run in pure simulation (dry-run) with no broker calls.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper endpoint. Do NOT point this at the live endpoint.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Safety switch ---------------------------------------------------------
# DRY_RUN=true prints the order payload instead of sending it. Keep it true
# unless you have deliberately reviewed the trade path and want paper fills.
DRY_RUN=true

# --- Simulation account (used when no Alpaca keys are configured) -----------
# Total equity the risk layer sizes positions against, in USD.
SIMULATED_TOTAL_EQUITY=100000
SIMULATED_CASH_BALANCE=100000
