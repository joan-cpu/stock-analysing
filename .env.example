# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.  NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Layer 2: Anthropic (Claude) API ---------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Analyst model. Defaults to the current Sonnet tier (claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5

# --- Layer 4: Dhan broker (India) ------------------------------------------
# SANDBOX (recommended): create a free token at https://developer.dhanhq.co
#   - no funded Dhan account needed; orders are simulated (fills at Rs 100)
# LIVE: use the Access Token + Client ID from your real Dhan account.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Which environment to target: "sandbox" (mock, default) or "live" (real money).
DHAN_ENV=sandbox

# Real-money safety lock. Even with DHAN_ENV=live and --submit, no live order is
# sent unless this is exactly true. Leave false until you truly mean it.
DHAN_ENABLE_LIVE_TRADING=false

# --- Market defaults -------------------------------------------------------
DEFAULT_EXCHANGE=NSE
# CNC = delivery (multi-day swing). INTRADAY / MARGIN / MTF / BO also valid.
PRODUCT_TYPE=CNC

# --- Safety switch ---------------------------------------------------------
# DRY_RUN=true prints the order payload instead of sending it. The CLI flag
# --submit overrides this per run.
DRY_RUN=true

# --- Simulation account (used when no Dhan creds are configured) ------------
# Mirrors the Dhan sandbox's daily virtual capital of Rs 10,00,000.
SIMULATED_TOTAL_EQUITY=1000000
SIMULATED_CASH_BALANCE=1000000
